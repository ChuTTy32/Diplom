# =============================================================================
# RansomGuard — пример конфигурации
# Скопируйте в .env и замените секреты:  cp .env.example .env
# Или запустите bash setup.sh — секреты сгенерируются автоматически.
# =============================================================================

# PostgreSQL / TimescaleDB
POSTGRES_USER=admin
POSTGRES_PASSWORD=<openssl rand -hex 16>
POSTGRES_DB=metrics

# BorgBackup — пароль шифрования WORM-репозитория
BORG_PASSPHRASE=<openssl rand -hex 24>

# Agent
WATCH_PATH=/tmp/monitored
ENTROPY_THRESHOLD=7.2
SCAN_INTERVAL=5

# Backend
SECRET_KEY=<openssl rand -hex 32>
DEBUG=false
# Разрешённые CORS origin'ы дашборда (через запятую). НЕ "*" — Zero Trust.
CORS_ORIGINS=http://localhost:3000

# Bearer-токен для аутентификации машина-машина (агент/borg → backend).
# Пусто — проверка отключена (демо). Сгенерировать: openssl rand -hex 32
RG_TOKEN=<openssl rand -hex 32>

# Оценка скорости восстановления для расчёта RTO (MB/s)
RESTORE_SPEED_MB_PER_SEC=100.0
